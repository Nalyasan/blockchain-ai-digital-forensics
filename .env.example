# Offline Portable Configuration Template (Zero Secrets / Keys / PII)
# Copy to .env or run .\setup.ps1 to initialize local offline defaults.

RPC_URL=http://127.0.0.1:8545
RPC_LABEL=local-anvil
DB_PATH=data/forensics.db
POLL_INTERVAL=2.0
CONFIRMATIONS=0
MAX_RETRIES=3
TIMEOUT=15
RATE_LIMIT_RPS=10
RPC_SYNTHETIC=true
RPC_FORK_BLOCK=0

# Rule Engine Calibration Parameters
RULE_LARGE_PERCENTILE=99
RULE_LARGE_MIN_SAMPLES=20
RULE_LARGE_ETH_FALLBACK_WEI=10000000000000000000
RULE_HIGH_FREQ_COUNT=10
RULE_HIGH_FREQ_WINDOW_SEC=300
RULE_FAN_MIN_COUNTERPARTIES=8
RULE_FAN_WINDOW_SEC=900
RULE_PASSTHROUGH_MAX_BLOCKS=5
RULE_PASSTHROUGH_ALPHA_MIN=0.80
RULE_PASSTHROUGH_ALPHA_MAX=1.05
RULE_PASSTHROUGH_MIN_ETH_WEI=1000000000000000000
RULE_PASSTHROUGH_MIN_PERCENTILE=90
TOKEN_THRESHOLDS_JSON={}

# Local Anvil Custody & Registry Defaults (PublicChains Blocked by Default)
ANCHOR_RPC_URL=http://127.0.0.1:8545
ANCHOR_CHAIN_ID=31337
EVIDENCE_REGISTRY_ADDRESS=
ANCHOR_PRIVATE_KEY=

# AI Investigator Offline Deterministic Mode (No Paid/Cloud Calls by Default)
FORENSICS_OFFLINE=1
AI_PROVIDER=none
AI_MODEL=offline-deterministic
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MAX_AI_TOOL_STEPS=5

# Public Chain Endpoints Disabled by Default
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
SEPOLIA_WALLET_ADDRESS=
